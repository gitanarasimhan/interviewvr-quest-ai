OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
APP_ENV=development

# HMAC request signing (shared secret between backend and Unity/Quest client)
QUEST_APP_SECRET=change-me-to-a-long-random-secret
REQUIRE_SIGNATURE=false
SIGNATURE_MAX_AGE_SECONDS=300

# Conversation session management
SESSION_HISTORY_WINDOW=6
SESSION_MAX_QUESTIONS=6
SESSION_TTL_SECONDS=3600

# Directory audio files must live under for /api/interview/transcribe
AUDIO_UPLOAD_DIR=uploads
